ckMediaItems(chords_track) - 1 do\n./reascript/vgt_read_chords.lua:312:    local item = reaper.GetTrackMediaItem(chords_track, index)\n./reascript/vgt_read_chords.lua:313:    local position = reaper.GetMediaItemInfo_Value(item, \"D_POSITION\")\n./reascript/vgt_read_chords.lua:314:    local length = reaper.GetMediaItemInfo_Value(item, \"D_LENGTH\")\n./reascript/vgt_read_chords.lua:316:      local take = reaper.GetActiveTake(item)\n./reascript/vgt_read_chords.lua:317:      local label = take and reaper.GetTakeName(take) or \"\"\n./reascript/vgt_read_chords.lua:336:  if project_path() == \"\" then error(\"Save the REAPER project before reading chords back.\") end\n./reascript/vgt_read_chords.lua:344:  -- This action only ever writes the sidecar file, never REAPER project\n./reascript/vgt_read_chords.lua:352:  reaper.ShowConsoleMsg(string.format(\"vgt: read %d chord item(s) from %s into the sidecar as human-verified.\\n\", #segments, CHORDS_NAME))\n./reascript/vgt_read_chords.lua:357:  reaper.ShowMessageBox(\"vgt: reading chords failed:\\n\" .. error_message, \"vgt\", 0)\n./reascript/vgt_initialize.lua:1:-- vgt Phase 0 apply action for REAPER 7.x.\n./reascript/vgt_initialize.lua:2:-- Install this file in REAPER's Action List and run it while the target RPP is open.\n./reascript/vgt_initialize.lua:3:-- It is the only writer of REAPER projects: the Python CLI intentionally never edits RPP text.\n./reascript/vgt_initialize.lua:11:  local _, path = reaper.EnumProjects(-1, \"\")\n./reascript/vgt_initialize.lua:15:local function sidecar_path()\n./reascript/vgt_initialize.lua:16:  -- The sidecar shares the project's name with a .vgt extension (Foo.RPP -> Foo.vgt).\n./reascript/vgt_initialize.lua:26:  local _, name = reaper.GetTrackName(track, \"\")\n./reascript/vgt_initialize.lua:37:  for index = 0, reaper.CountTracks(0) - 1 do\n./reascript/vgt_initialize.lua:38:    local track = reaper.GetTrack(0, index)\n./reascript/vgt_initialize.lua:51:  local forced = reaper.GetExtState(\