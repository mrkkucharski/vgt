rski/projects/vgt\",\n      \"agents\": [\n        \"claude\",\n        \"codex\"\n      ],\n      \"status\": \"active\",\n      \"budget\": {\n        \"mode\": \"subscription\",\n        \"window_hours\": 5.0,\n        \"cap_fraction\": 0.8,\n        \"dollar_limit\": null,\n        \"token_limit\": 200000\n      },\n      \"verification_command\": null\n    }\n  ]\n}\n    local_path = Path(registry.base_dir) / args.name\n\n    repo_sync.ensure_repo(full_repo, local_path, private=not args.public)\n\n    added = _scaffold_non_destructive(local_path)\n    if added:\n        _git(local_path, \"add\", *added)\n        _commit_if_staged(local_path, \"chore(pm): add missing proj-mgr template files\")\n        _git(local_path, \"push\", \"-u\", \"origin\", \"HEAD\")\n\n    github.ensure_labels(full_repo)\n\n    budget = BudgetConfig(\n        mode=\"pay_as_you_go\" if args.pay_as_you_go else \"subscription\",\n        window_hours=args.window_hours,\n        cap_fraction=args.cap_fraction,\n        dollar_limit=args.dollar_limit,\n        token_limit=args.token_limit,\n    )\n    agents = [AgentKind(a.strip()) for a in args.agents.split(\",\") if a.strip()]\n    if not agents:\n        raise ValueError(\"--agents must list at least one agent\")\n    _upsert_project(\n        registry, args.name, full_repo, str(local_path), agents, budget,\n        verification_command=getattr(args, \"verification_command\", None),\n        update_verification=hasattr(args, \"verification_command\"),\n    )\n    config.save_registry(registry)\n\n    print(f\"opened {args.name} -> {full_repo} at {local_path}\")\n    if added:\n        print(f\"added missing template files: {', '.join(added)}\")\n    print(\"check docs/GOAL.md is up to date before the orchestrator starts working this project\")\n\n\ndef _upsert_project(\n    registry, name: str, full_repo: str, local_path: str, agents: List[AgentKind], budget: BudgetConfig,\n    verification_command: str | None = None, update_verification: bool = False,\n) -> None:\n    for p in registry.projects:\n        if p.name == name:\n            p.repo = full_repo\n            p.local_path = local_path\n            p.agents = agents\n            p.budget = budget\n            if update_verification:\n                if not verification_command or not verification_command.strip():\n                    raise ValueError(\"--verification-command must not be empty\")\n                p.verification_command = verification_command.strip()\n            p.status = ProjectStatus.ACTIVE  # re-opening means \"start a new iteration\"\n            return\n    registry.projects.append(\n        Project(\n            name=name, repo=full_repo, local_path=local_path, agents=agents,\n            status=ProjectStatus.ACTIVE, budget=budget,\n            verification_command=verification_command.strip() if verification_command else None,\n        )\n    )\n\n\ndef _scaffold_non_destructive(local_path: Path) -> list:\n    \"\"\"Copy template files that don't already exist locally. Never overwrites -- an\n    existing project may already have its own AGENTS.md/docs/GOAL.md/etc that\n    shouldn't be clobbered just because it's being (re-)opened.\n    \"\"\"\n    added = []\n    for src in sorted(config.TEMPLATE_PROJECT_DIR.rglob(\"*\")):\n        if src.is_dir():\n            continue\n        rel = src.relative_to(config.TEMPLATE_PROJECT_DIR)\n        dest = local_path / rel\norchestrator/bin/pm close my-project               # unregister project (local clone + GitHub repo untouched)\norchestrator/bin/pm run-once                       # run a single orchestration pass\norchestrator/bin/pm run                            # start the orchestrator as a background daemon\norchestrator/bin/pm run --interval 120             # ... checking every 2 minutes (default: 60s)\norchestrator/bin/pm stop                           # stop the running daemon\n```\n\nCurrently zero third-party dependencies (stdlib only); add them to\n`orchestrator/pyproject.toml` and run `uv lock` from `orchestrator/` as that changes.\n\n### `pm open <name>`\n\nReconciles the local clone and GitHub repo for a project by name, then adds it (or\nupdates it) in `registry.json`:\n\nBy default a project may use both agents (`claude,codex`), and the scheduler always\nstarts new issues on whichever one currently has the most unused budget headroom. Pass\n`--agents` with a comma-separated list to change which agents are allowed -- e.g.\n`--agents codex` to pin a project to Codex only. Order doesn't matter; selection is\nalways budget-based. Other flags: `--public` (create a public repo instead of\nprivate), `--window-hours`, `--cap-fraction`, `--token-limit`, `--pay-as-you-go`,\nand `--dollar-limit` configure the project's budget. `--verification-command`\ndeclares the shell command that must independently pass from the project root before\nthe orchestrator can mark it `finished`. There is intentionally no inferred default:\nwithout a declared command, the project stays active and proj-mgr files a follow-up\nissue. The command's exit status, UTC timestamps, and up to 4,000 characters of\ncombined output are recorded in `.pm/log.ndjson` as `project.verification`.\n\n- **neither exists** -- creates the GitHub repo, clones it locally, scaffolds it from\n  `templates/project/`.\n- **remote only** -- clones it locally, then scaffolds any missing template files.\n- **local only** -- creates the GitHub repo, links `origin`, pushes existing local\n  commits.\n- **both exist** -- links `origin` if missing, fetches, and fast-forwards whichever\n  side is behind. Never force-pushes, never auto-resolves a diverged history, never\n  relinks `origin` if it already points somewhere unexpected -- those cases raise an\n","exit_code":0,"status":"completed"}}
