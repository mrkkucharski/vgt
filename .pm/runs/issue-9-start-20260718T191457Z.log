{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'review_tmp=$(mktemp -d /tmp/vgt-review-XXXXXX)\ncp -R '\"'test/Reaper Project' \\\"\"'$review_tmp/Reaper Project\"\nreview_project=\"$review_tmp/Reaper Project/Reaper Project.RPP\"\npython - \"$review_project\" <<'\"'PY'\nimport json, sys\nfrom pathlib import Path\nproject = Path(sys.argv[1])\nproject.with_suffix('.vgt').write_text(json.dumps({'schema_version': 1, 'managed_track_guids': [], 'config': {'reference_track_guid': '{75418143-1F31-B548-B7D2-96815CB0297D}'}}))\nPY\nuv run vgt analyze \\\"\"'$review_project\" > \"$review_tmp/result.json\"\npython - \"$review_tmp/result.json\" \"$review_project\" <<'\"'PY'\nimport json, sys\nfrom pathlib import Path\nresult = json.loads(Path(sys.argv[1]).read_text())\nproject = Path(sys.argv[2])\ntempo = result['analysis']['tempo']['value']\nkey = result['analysis']['key']['value']\nchords = result['analysis']['chords']['value']\ngrid = set(tempo['beat_times'])\nprint(f\\\"key={key['root']} {key['scale']} confidence={key['confidence']} backend={key['backend']}\\\")\nprint(f\\\"chords={len(chords['segments'])} backend={chords['backend']} vocabulary={chords['vocabulary']}\\\")\nprint('boundaries_on_tempo_grid=' + str(all(s['start_seconds'] in grid and s['end_seconds'] in grid for s in chords['segments'])))\nprint('sheet_exists=' + str(project.with_name(chords['chord_sheet_path']).is_file()))\nprint(project.with_name(chords['chord_sheet_path']).read_text()[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
