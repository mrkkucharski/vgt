lary\", \"backend\"}` for\nsrc/vgt/chords.py-229-    `source`, with every chord segment boundary snapped to `beat_times` --\nsrc/vgt/chords.py-230-    the shared grid from the tempo stage (see module docstring).\"\"\"\nsrc/vgt/chords.py-231-    del settings  # no tunables yet; accepted for a uniform detector signature\nsrc/vgt/chords.py-232-    if not source.is_file():\nsrc/vgt/chords.py-233-        raise ChordDetectionError(f\"Reference source file not found: {source}\")\nsrc/vgt/chords.py-234-    grid = sorted(beat_times)\nsrc/vgt/chords.py-235-    if len(grid) < 2:\nsrc/vgt/chords.py:236:        raise ChordDetectionError(f\"Too few beats in the shared grid ({len(grid)}) to snap chords to.\")\nsrc/vgt/chords.py-237-\nsrc/vgt/chords.py:238:    madmom_result = _madmom_chords(source)\nsrc/vgt/chords.py-239-    if madmom_result is not None:\nsrc/vgt/chords.py-240-        raw_segments, backend = madmom_result, \"madmom\"\nsrc/vgt/chords.py-241-    else:\nsrc/vgt/chords.py:242:        chordino_result = _chordino_chords(source)\nsrc/vgt/chords.py-243-        if chordino_result is not None:\nsrc/vgt/chords.py-244-            raw_segments, backend = chordino_result, \"chordino\"\nsrc/vgt/chords.py-245-        else:\nsrc/vgt/chords.py:246:            raw_segments, backend = _template_chords(source, grid), \"librosa\"\nsrc/vgt/chords.py-247-\nsrc/vgt/chords.py-248-    segments = _snap_segments_to_grid(raw_segments, grid)\nsrc/vgt/chords.py-249-\nsrc/vgt/chords.py-250-    return {\n--\nsrc/vgt/chords.py-257-\nsrc/vgt/chords.py-258-def chord_sheet_path(project_path: Path) -> Path:\nsrc/vgt/chords.py-259-    \"\"\"Verification artifact lives next to the sidecar, not inside the\nsrc/vgt/chords.py-260-    project's own Media folder -- it is vgt-owned, not part of the song.\"\"\"\nsrc/vgt/chords.py:261:    return project_path.with_name(f\"{project_path.stem}.vgt-chords.txt\")\nsrc/vgt/chords.py-262-\nsrc/vgt/chords.py-263-\nsrc/vgt/chords.py-264-def _format_timestamp(seconds: float) -> str:\nsrc/vgt/chords.py-265-    minutes, remainder = divmod(max(seconds, 0.0), 60)\nsrc/vgt/chords.py-266-    return f\"{int(minutes):02d}:{remainder:05.2f}\"\nsrc/vgt/chords.py-267-\nsrc/vgt/chords.py-268-\nsrc/vgt/chords.py:269:def render_chord_sheet(chords_value: dict[str, Any], destination: Path) -> Path:\nsrc/vgt/chords.py-270-    \"\"\"Write a plain-text chord sheet (timestamp + label per segment) for\nsrc/vgt/chords.py:271:    by-eye verification of the detected chord sequence.\"\"\"\nsrc/vgt/chords.py-272-    lines = [\nsrc/vgt/chords.py:273:        f\"# vocabulary: {chords_value['vocabulary']} (7ths/sus/etc. collapse to nearest maj/min match)\",\nsrc/vgt/chords.py:274:        f\"# backend: {chords_value['backend']}\",\nsrc/vgt/chords.py-275-        \"\",\nsrc/vgt/chords.py-276-    ]\nsrc/vgt/chords.py:277:    for segment in chords_value[\"segments\"]:\nsrc/vgt/chords.py-278-        lines.append(f\"{_format_timestamp(segment['start_seconds'])}  {segment['chord']}\")\nsrc/vgt/chords.py-279-    destination.parent.mkdir(parents=True, exist_ok=True)\nsrc/vgt/chords.py-280-    destination.write_text(\"\\n\".join(lines) + \"\\n\", encoding=\"utf-8\")\nsrc/vgt/chords.py-281-    return destination\n--\nscripts/verify_phase0_apply.py-72-        raise VerificationError(f\"cannot read sidecar {sidecar_file}: {error}\") from error\nscripts/verify_phase0_apply.py-73-    except json.JSONDecodeError as error:\nscripts/verify_phase0_apply.py-74-        raise VerificationError(f\"invalid JSON in {sidecar_file}: {error}\") from error\nscripts/verify_phase0_apply.py-75-\nscripts/verify_phase0_apply.py:76:    if sidecar.get(\"schema_version\") != 1:\nscripts/verify_phase0_apply.py:77:        _fail(\"sidecar schema_version is not 1\")\nscripts/verify_phase0_apply.py-78-    config = sidecar.get(\"config\")\nscripts/verify_phase0_apply.py-79-    if not isinstance(config, dict):\nscripts/verify_phase0_apply.py-80-        _fail(\"sidecar config is missing or not an object\")\n