,{\"path\":\"tests/test_analysis.py\",\"additions\":89,\"deletions\":8,\"changeType\":\"MODIFIED\"},{\"path\":\"tests/test_reascript.py\",\"additions\":5,\"deletions\":1,\"changeType\":\"MODIFIED\"}],\"headRefName\":\"issue-19-preserve-originally-detected-chords-alon\",\"isDraft\":false,\"mergeable\":\"MERGEABLE\",\"number\":22,\"reviewDecision\":\"\",\"state\":\"OPEN\",\"title\":\"Preserve originally-detected chords alongside human corrections (both always available)\"}\n","exit_code":0,"status":"completed"}}
