, \"scheduled\": 0, \"followups_created\": 0}}\n{\"ts\": \"2026-07-20T14:13:50.233654+00:00\", \"project\": \"vgt\", \"event\": \"orchestrator.no_capacity\", \"detail\": {\"message\": \"work is available, but scheduler capacity or budget headroom is exhausted\"}}\n{\"ts\": \"2026-07-20T14:14:56.953530+00:00\", \"project\": \"vgt\", \"event\": \"orchestrator.pass_outcome\", \"detail\": {\"outcomes\": [\"deferred\"], \"scheduled\": 0, \"followups_created\": 0}}\n{\"ts\": \"2026-07-20T14:14:56.954076+00:00\", \"project\": \"vgt\", \"event\": \"orchestrator.no_capacity\", \"detail\": {\"message\": \"work is available, but scheduler capacity or budget headroom is exhausted\"}}\n{\"ts\": \"2026-07-20T14:16:04.083711+00:00\", \"project\": \"vgt\", \"event\": \"orchestrator.pass_outcome\", \"detail\": {\"outcomes\": [\"deferred\"], \"scheduled\": 0, \"followups_created\": 0}}\n{\"ts\": \"2026-07-20T14:16:04.084481+00:00\", \"project\": \"vgt\", \"event\": \"orchestrator.no_capacity\", \"detail\": {\"message\": \"work is available, but scheduler capacity or budget headroom is exhausted\"}}\n{\"ts\": \"2026-07-20T14:17:10.461467+00:00\", \"project\": \"vgt\", \"event\": \"agent.ready_for_review\", \"detail\": {\"issue\": 45, \"agent\": \"codex\", \"role\": \"implement\"}}\n{\"ts\": \"2026-07-20T14:17:16.354187+00:00\", \"project\": \"vgt\", \"event\": \"pr.created\", \"detail\": {\"issue\": 45, \"pr\": 51, \"branch\": \"issue-45-m1-b-lalal-api-v1-backend-lalalseparator\"}}\n","exit_code":0,"status":"completed"}}
