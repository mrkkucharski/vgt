dio\")\nsrc/vgt/lalal.py:251:                raise LalalError(\"LALAL download is not a readable WAV file\") from exc\nsrc/vgt/lalal.py:255:            raise LalalError(f\"LALAL download failed: {self._redact(exc)}\") from exc\nsrc/vgt/lalal.py:284:                raise LalalError(f\"LALAL completed task without required {side} track\")\nsrc/vgt/lalal.py:291:                    raise LalalError(\"LALAL download URL expired and could not be refreshed\")\nsrc/vgt/sidecar.py:48:               \"sha256\": str, \"size_bytes\": int, \"duration_seconds\": float,\nsrc/vgt/sections.py:96:def _pick_boundaries(novelty: Any, frame_times: Any, duration: float, min_gap_seconds: float) -> list[float]:\nsrc/vgt/sections.py:111:    if duration - boundaries[-1] >= min_gap_seconds:\nsrc/vgt/sections.py:112:        boundaries.append(duration)\nsrc/vgt/sections.py:114:        boundaries[-1] = duration\nsrc/vgt/sections.py:115:    return boundaries if len(boundaries) >= 2 else [0.0, duration]\nsrc/vgt/sections.py:162:    duration = float(librosa.get_duration(y=y, sr=sr))\nsrc/vgt/sections.py:176:    boundaries = _pick_boundaries(novelty, frame_times, duration, min_section_seconds)\nsrc/vgt/separation.py:30:    validated (readable WAV, non-zero duration) before it is committed as an\nsrc/vgt/separation.py:229:    def __init__(self, fail_at: str | None = None, sample_rate: int = 8000, duration_seconds: float = 0.2) -> None:\nsrc/vgt/separation.py:232:        self.duration_seconds = duration_seconds\nsrc/vgt/separation.py:266:            _write_fake_wav(part_path, self.sample_rate, self.duration_seconds, seed=_content_seed(source, spec, side))\nsrc/vgt/separation.py:294:def _write_fake_wav(path: Path, sample_rate: int, duration_seconds: float, *, seed: int = 0) -> None:\nsrc/vgt/separation.py:295:    frame_count = max(1, int(sample_rate * duration_seconds))\nsrc/vgt/separation.py:318:    plausible (non-zero) duration; otherwise return that duration in\nsrc/vgt/separation.py:469:                duration_seconds = _validate_wav(local_path)\nsrc/vgt/separation.py:481:                    \"duration_seconds\": duration_seconds,\nsrc/vgt/separation.py:562:    # loop starts any of the outstanding paid operations.  It intentionally\nsrc/vgt/separation.py:565:    outstanding = 0\nsrc/vgt/separation.py:580:            outstanding += 1\nsrc/vgt/separation.py:581:    preflight = getattr(backend, \"preflight\", None)\nsrc/vgt/separation.py:582:    if outstanding and callable(preflight):\nsrc/vgt/separation.py:583:        preflight(source=source, outstanding_operations=outstanding)\n","exit_code":0,"status":"completed"}}
