quest must never\nsrc/vgt/separation.py-428-    # be reused as if it were for this one.\nsrc/vgt/separation.py-429-    matches_prior_attempt = record.get(\"source_sha256\") == source_sha256 and record.get(\"spec_hash\") == current_spec_hash\nsrc/vgt/separation.py-430-    resumable = matches_prior_attempt and bool(record.get(\"backend_state\"))\nsrc/vgt/separation.py-431-    resume_state = dict(record.get(\"backend_state\") or {}) if resumable else None\nsrc/vgt/separation.py-432-    if resumable:\nsrc/vgt/separation.py-433-        emit(f\"{op_def.operation_id}: resuming previous attempt\")\nsrc/vgt/separation.py-434-    else:\nsrc/vgt/separation.py-435-        emit(f\"{op_def.operation_id}: starting\")\nsrc/vgt/separation.py-436-        record[\"backend_state\"] = {}\nsrc/vgt/separation.py-437-\nsrc/vgt/separation.py:438:    record[\"status\"] = \"in_progress\"\nsrc/vgt/separation.py-439-    record[\"source_sha256\"] = source_sha256\nsrc/vgt/separation.py-440-    record[\"spec_hash\"] = current_spec_hash\nsrc/vgt/separation.py-441-    record[\"requested_presets\"] = op_def.spec.to_dict()\nsrc/vgt/separation.py-442-    record[\"error\"] = None\nsrc/vgt/separation.py-443-    # Durably record intent to run this operation *before* calling the\nsrc/vgt/separation.py-444-    # backend: if the process dies before the backend's own first checkpoint,\nsrc/vgt/separation.py:445:    # the next run still sees \"in_progress\" with no backend_state, not\nsrc/vgt/separation.py-446-    # \"pending\" (which would look untouched).\nsrc/vgt/separation.py-447-    persist()\nsrc/vgt/separation.py-448-\nsrc/vgt/separation.py-449-    def checkpoint(backend_state: dict[str, Any]) -> None:\nsrc/vgt/separation.py-450-        record[\"backend_state\"] = {**record.get(\"backend_state\", {}), **backend_state}\nsrc/vgt/separation.py-451-        persist()\nsrc/vgt/separation.py-452-\nsrc/vgt/separation.py-453-    work_dir = stems_dir(project_path, namespace) / \"_work\" / op_def.operation_id\nsrc