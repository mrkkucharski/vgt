rbatim on re-apply\n    92\t-- rather than silently dropping any analysis a user has already run.\n    93\tlocal function read_analysis_block()\n    94\t  local body = read_sidecar_body()\n    95\t  if not body then return nil end\n    96\t  local key_start = body:find('\"analysis\"%s*:%s*{')\n    97\t  if not key_start then return nil end\n    98\t  local brace_start = body:find(\"{\", key_start)\n    99\t  local depth = 0\n   100\t  for index = brace_start, #body do\n   101\t    local char = body:sub(index, index)\n   102\t    if char == \"{\" then\n   103\t      depth = depth + 1\n   104\t    elseif char == \"}\" then\n   105\t      depth = depth - 1\n   106\t      if depth == 0 then return body:sub(brace_start, index) end\n   107\t    end\n   108\t  end\n   109\t  return nil\n   110\tend\n   111\t\n   112\tlocal function remove_previous_managed_tracks()\n   113\t  local managed = read_managed_guids()\n   114\t  -- A GUID in the sidecar alone is not enough: preserve any track whose current name is not vgt-owned.\n   115\t  for index = reaper.CountTracks(0) - 1, 0, -1 do\n   116\t    local track = reaper.GetTrack(0, index)\n   117\t    if managed[reaper.GetTrackGUID(track)] and starts_with_vgt(track) then\n   118\t      reaper.DeleteTrack(track)\n   119\t    end\n   120\t  end\n   121\tend\n   122\t\n   123\tlocal function find_track_by_guid(guid)\n   124\t  for index = 0, reaper.CountTracks(0) - 1 do\n   125\t    local track = reaper.GetTrack(0, index)\n   126\t    if reaper.GetTrackGUID(track) == guid then return track end\n   127\t  end\n   128\t  return nil\n   129\tend\n   130\t\n   131\tlocal function copy_file_backed_items(source, destination)\n   132\t  for item_index = 0, reaper.CountTrackMediaItems(source) - 1 do\n   133\t    local source_item = reaper.GetTrackMediaItem(source, item_index)\n   134\t    local source_take = reaper.GetActiveTake(source_item)\n   135\t    if source_take then\n   136\t      local source_media = reaper.GetMediaItemTake_Source(source_take)\n   137\t      -- Lua returns the filename directly (unlike several APIs that return an\n   138\t      -- `ok, value` pair). Keeping it in one variable avoids passing nil to\n   139\t      -- PCM_Source_CreateFromFile and leaving an empty item behind.\n   140\t      local filename = reaper.GetMediaSourceFileName(source_media, \"\")\n   141\t      if filename ~= \"\" then\n   142\t        local item = reaper.AddMediaItemToTrack(destination)\n   143\t        reaper.SetMediaItemInfo_Value(item, \"D_POSITION\", reaper.GetMediaItemInfo_Value(source_item, \"D_POSITION\"))\n   144\t        reaper.SetMediaItemInfo_Value(item, \"D_LENGTH\", reaper.GetMediaItemInfo_Value(source_item, \"D_LENGTH\"))\n   145\t        local take = reaper.AddTakeToMediaItem(item)\n   146\t        reaper.SetMediaItemTake_Source(take, reaper.PCM_Source_CreateFromFile(filename))\n   147\t        reaper.SetMediaItemTakeInfo_Value(take, \"D_STARTOFFS\", reaper.GetMediaItemTakeInfo_Value(source_take, \"D_STARTOFFS\"))\n   148\t        reaper.SetMediaItemTakeInfo_Value(take, \"D_PLAYRATE\", reaper.GetMediaItemTakeInfo_Value(source_take, \"D_PLAYRATE\"))\n   149\t        reaper.SetMediaItemTakeInfo_Value(take, \"D_PITCH\", reaper.GetMediaItemTakeInfo_Value(source_take, \"D_PITCH\"))\n   150\t      end\n   151\t    end\n   152\t  end\n   153\tend\n   154\t\n   155\tlocal function write_settings(folder, mirror, reference)\n   156\t  -- Preserve any analysis the Python CLI already wrote (schema v2); a fresh\n   157\t  -- sidecar with no prior analysis stays schema v1, matching Phase 0's\n   158\t  -- long-standing on-disk format.\n   159\t  local analysis = read_analysis_block()\n   160\t  local schema_version = analysis and 2 or 1\n   161\t  local analysis_field = analysis and ('\\n  \"analysis\": ' .. analysis .. \",\") or \"\"\n   162\t\n   163\t  local file, error_message = io.open(sidecar_path(), \"w\")\n   164\t  if not file then error(error_message) end\n   165\t  file:write(string.format([[{\n   166\t  \"schema_version\": %d,%s\n   167\t  \"managed_track_guids\": [\"%s\", \"%s\"],\n   168\t  \"config\": {\"reference_track_name\": \"%s\", \"reference_track_guid\": \"%s\", \"folder_name\": \"%s\", \"mirror_name\": \"%s\"}\n   169\t}\n   170\t]],\n   171\t    schema_version, analysis_field,\n   172\t    reaper.GetTrackGUID(folder), reaper.GetTrackGUID(mirror),\n   173\t    escaped(track_name(reference)), reaper.GetTrackGUID(reference),\n   174\t    escaped(PREFIX .. \" \" .. track_name(reference)), escaped(MIRROR_NAME)))\n   175\t  file:close()\n   176\tend\n   177\t\n   178\tlocal function apply()\n   179\t  local path = project_path()\n   180\t  if path == \"\" then error(\"Save the REAPER project before running vgt Phase 0.\") end\n   181\t\n   182\t  -- Choose the reference before mutating anything, so cancelling leaves the project untouched.\n   183\t  local reference = choose_reference(candidate_tracks())\n   184\t  if not reference then return end\n   185\t  local reference_guid = reaper.GetTrackGUID(reference)\n   186\t  local folder_name = PREFIX .. \" \" .. track_name(reference)\n   187\t\n   188\t  reaper.Undo_BeginBlock()\n   189\t  reaper.PreventUIRefresh(1)\n   190\t  remove_previous_managed_tracks()\n     1\t\"\"\"Read-only helpers for locating and inspecting REAPER RPP projects.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom dataclasses import asdict, dataclass\n     6\tfrom pathlib import Path\n     7\timport re\n     8\t\n     9\t\n    10\tclass ProjectError(ValueError):\n    11\t    \"\"\"A project cannot be located or does not contain required RPP data.\"\"\"\n    12\t\n    13\t\n    14\t@dataclass(frozen=True)\n    15\tclass TrackInfo:\n    16\t    name: str\n    17\t    guid: str\n    18\t\n    19\t\n    20\t@dataclass(frozen=True)\n    21\tclass ProjectInfo:\n    22\t    path: Path\n    23\t    sample_rate: int\n    24\t    tempo: float\n    25\t    time_signature_numerator: int\n    26\t    time_signature_denominator: int\n    27\t    tracks: tuple[TrackInfo, ...]\n    28\t\n    29\t    def to_dict(self) -> dict[str, object]:\n    30\t        result = asdict(self)\n    31\t        result[\"path\"] = str(self.path)\n    32\t        return result\n    33\t\n    34\t\n    35\t_SAMPLERATE = re.compile(r\"^\\s*SAMPLERATE\\s+(\\d+)\", re.MULTILINE)\n    36\t_TEMPO = re.compile(r\"^\\s*TEMPO\\s+([0-9.]+)\\s+(\\d+)\\s+(\\d+)\", re.MULTILINE)\n    37\t_TRACK_START = re.compile(r\"^\\s*<TRACK\\s+({[^}]+})\", re.MULTILINE)\n    38\t_NAME = re.compile(r'^\\s*NAME\\s+(?:\"(?P<quoted>.*)\"|(?P<plain>\\S.*))\\s*$', re.MULTILINE)\n    39\t_FILE = re.compile(r'^\\s*FILE\\s+\"(?P<path>[^\"]*)\"', re.MULTILINE)\n    40\t\n    41\t\n    42\tdef locate_project(project: str | Path | None, working_directory: Path | None = None) -> Path:\n    43\t    \"\"\"Resolve an explicit RPP path or the single RPP in the working directory.\"\"\"\n    44\t    if project is not None:\n    45\t        path = Path(project).expanduser().resolve()\n    46\t        if not path.is_file() or path.suffix.lower() != \".rpp\":\n    47\t            raise ProjectError(f\"REAPER project not found: {path}\")\n    48\t        return path\n    49\t\n    50\t    directory = (working_directory or Path.cwd()).resolve()\n    51\t    candidates = sorted(path for path in directory.iterdir() if path.is_file() and path.suffix.lower() == \".rpp\")\n    52\t    if not candidates:\n    53\t        raise ProjectError(f\"No .RPP project found in {directory}; pass a project path explicitly.\")\n    54\t    if len(candidates) > 1:\n    55\t        names = \", \".join(path.name for path in candidates)\n    56\t        raise ProjectError(f\"More than one .RPP project found in {directory}: {names}. Pass one explicitly.\")\n    57\t    return candidates[0]\n    58\t\n    59\t\n    60\tdef _track_blocks(text: str) -> list[tuple[str, str]]:\n    61\t    \"\"\"Return each top-level track GUID and its RPP chunk without parsing nested chunks.\"\"\"\n    62\t    starts = list(_TRACK_START.finditer(text))\n    63\t    blocks: list[tuple[str, str]] = []\n    64\t    for start in starts:\n    65\t        depth = 0\n    66\t        for line_match in re.finditer(r\".*(?:\\n|$)\", text[start.start() :]):\n    67\t            line = line_match.group(0)\n    68\t            stripped = line.strip()\n    69\t            if stripped.startswith(\"<\"):\n    70\t                depth += 1\n    71\t            elif stripped == \">\":\n    72\t                depth -= 1\n    73\t                if depth == 0:\n    74\t                    end = start.start() + line_match.end()\n    75\t                    blocks.append((start.group(1), text[start.start() : end]))\n    76\t                    break\n    77\t        else:\n    78\t            raise ProjectError(f\"Malformed TRACK chunk for {start.group(1)}\")\n    79\t    return blocks\n    80\t\n    81\t\n    82\tdef read_project(path: str | Path) -> ProjectInfo:\n    83\t    \"\"\"Read Phase 0 metadata without changing the RPP file.\"\"\"\n    84\t    project_path = locate_project(path)\n    85\t    text = project_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    86\t    sample_rate = _SAMPLERATE.search(text)\n    87\t    tempo = _TEMPO.search(text)\n    88\t    if sample_rate is None or tempo is None:\n    89\t        raise ProjectError(f\"{project_path} does not contain SAMPLERATE and TEMPO settings\")\n    90\t\n    91\t    tracks = []\n    92\t    for guid, block in _track_blocks(text):\n    93\t        name_match = _NAME.search(block)\n    94\t        tracks.append(TrackInfo(name=(name_match.group(\"quoted\") or name_match.group(\"plain\")) if name_match else \"\", guid=guid))\n    95\t    return ProjectInfo(\n    96\t        path=project_path,\n    97\t        sample_rate=int(sample_rate.group(1)),\n    98\t        tempo=float(tempo.group(1)),\n    99\t        time_signature_numerator=int(tempo.group(2)),\n   100\t        time_signature_denominator=int(tempo.group(3)),\n   101\t        tracks=tuple(tracks),\n   102\t    )\n   103\t\n   104\t\n   105\tdef track_source_path(project: str | Path, track_guid: str) -> Path:\n   106\t    \"\"\"Resolve the on-disk media file backing a track's first item, by GUID.\n   107\t\n   108\t    Used to hand the reference track's audio to the analysis stage, which reads\n   109\t    the file directly rather than going through REAPER.\n   110\t    \"\"\"\n   111\t    project_path = locate_project(project)\n   112\t    text = project_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n   113\t    for guid, block in _track_blocks(text):\n   114\t        if guid != track_guid:\n   115\t            continue\n   116\t        file_match = _FILE.search(block)\n   117\t        if file_match is None:\n   118\t            raise ProjectError(f\"Track {track_guid} has no file-backed media source.\")\n   119\t        return (project_path.parent / file_match.group(\"path\")).resolve()\n   120\t    raise ProjectError(f\"No track with GUID {track_guid} found in {project_path}.\")\n","exit_code":0,"status":"completed"}}
