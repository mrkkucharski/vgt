# REAPER-generated, regenerable artifacts (peaks are rebuilt on open;
# backups are auto-saved). Keep the fixture project + media, drop the noise.
*.reapeaks
peaks/
Backups/
*.rpp-bak
*-bak

# Local Python bytecode is generated by the test environment.
__pycache__/
*.py[cod]
.venv/

# macOS Finder metadata.
.DS_Store

# Regenerable vgt analysis/stem artifacts under a test fixture's
# `vgt/<namespace>/` folder (see docs/stem-separation-plan.md's Artifact
# layout), plus the per-project sidecar and its write lock that appear next
# to any fixture `.RPP` once `vgt analyze` runs against it; real user
# projects live outside this repo, so this is scoped to the checked-in
# fixtures only.
test/**/vgt/
test/**/*.vgt
test/**/.*.vgt.lock

# test/7Rivers is the exception: its vgt output and sidecar are committed
# as a reproducibility baseline. The write lock stays ignored everywhere
# (including here) -- it's a runtime mutex, not baseline content.
!test/7Rivers/vgt/
!test/7Rivers/7Rivers.vgt

# Orchestrator logs: raw per-run agent transcripts and the event stream. Both are
# written locally and grow without bound; neither is read back from the repo (the
# event stream is mirrored to the orchestrator's own logs dir), so they are kept
# on disk for post-mortems but never versioned. `.pm/state.json` stays tracked.
.pm/runs/
.pm/log.ndjson
