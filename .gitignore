# REAPER-generated, regenerable artifacts (peaks are rebuilt on open;
# backups are auto-saved). Keep the fixture project + media, drop the noise.
*.reapeaks
peaks/
Backups/
*.rpp-bak
*-bak

# Local Python bytecode is generated by the test environment.
__pycache__/
*.py[cod]
.venv/

# macOS Finder metadata.
.DS_Store

# Regenerable vgt analysis/stem artifacts under the test fixture's
# `vgt/<namespace>/` folder (see docs/stem-separation-plan.md's Artifact
# layout); real user projects live outside this repo, so this is scoped to
# the checked-in fixture only.
test/**/vgt/

# Orchestrator run transcripts: raw agent JSONL, ~6.7MB and growing, larger
# than the source tree itself. Kept on disk for post-mortems, but the durable
# record lives in .pm/log.ndjson, the issue threads, and git history.
.pm/runs/
